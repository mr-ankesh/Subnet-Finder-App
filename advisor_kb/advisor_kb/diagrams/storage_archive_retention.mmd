%% Pattern: storage_archive_retention
%% Placeholders: {APP} {VNET} {SUBNET} {SA_NAME} {ENV} {RETENTION}
flowchart LR
    subgraph CONSUMER["Writer"]
        APP["{APP}<br/>writes retention data"]
    end

    subgraph SPOKE["Spoke VNET — {VNET}"]
        SNET["Subnet — {SUBNET}"]
        PE["Private Endpoint<br/>sub-resource: blob"]
        SNET --- PE
    end

    subgraph HUB["Hub"]
        DNS["privatelink.blob.core.windows.net"]
    end

    subgraph AZ["Azure Storage — {ENV}"]
        SA["{SA_NAME}<br/>StorageV2 · Standard<br/>LRS or GRS (archive constraint)<br/>CMK · TLS 1.2"]
        KV["Key Vault Premium<br/>RSA-HSM key"]
        SA -->|"encrypts with"| KV
    end

    subgraph LIFE["Lifecycle — retention {RETENTION}"]
        T1["Cool"]
        T2["Archive<br/>rehydration takes hours"]
        T1 -->|"after N days"| T2
    end

    APP --> SNET
    PE ==>|"private link"| SA
    SNET -.-> DNS
    DNS -.-> PE
    SA --> T1

    classDef sec fill:#0b3d2e,stroke:#1f9d63,color:#e8fff4
    classDef net fill:#0b2f4d,stroke:#2a7fbf,color:#e8f4ff
    classDef warn fill:#4d3b0b,stroke:#bf922a,color:#fff8e8
    class SA,KV sec
    class PE,DNS,SNET net
    class T2 warn
