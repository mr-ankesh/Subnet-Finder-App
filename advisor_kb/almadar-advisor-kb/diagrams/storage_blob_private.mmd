%% Pattern: storage_blob_private_standard
%% Placeholders: {APP} {VNET} {SUBNET} {SA_NAME} {ENV}
flowchart LR
    subgraph CONSUMER["Workload"]
        APP["{APP}<br/>AKS / VM / Application"]
    end

    subgraph USER["End users (if applicable)"]
        U["Presight user"]
        ZPA["ZPA connector"]
        U -->|"private access"| ZPA
    end

    subgraph SPOKE["Spoke VNET — {VNET}"]
        SNET["Subnet — {SUBNET}"]
        PE["Private Endpoint<br/>sub-resource: blob"]
        SNET --- PE
    end

    subgraph HUB["Hub"]
        DNS["Private DNS Zone<br/>privatelink.blob.core.windows.net"]
    end

    subgraph AZ["Azure Storage — {ENV}"]
        SA["{SA_NAME}<br/>StorageV2 · Standard · ZRS<br/>CMK · TLS 1.2 · public access disabled"]
        KV["Key Vault Premium<br/>RSA-HSM key"]
        SA -->|"encrypts with"| KV
    end

    APP --> SNET
    ZPA --> SNET
    PE ==>|"private link"| SA
    SNET -.->|"name resolution"| DNS
    DNS -.->|"resolves to private IP"| PE

    classDef sec fill:#0b3d2e,stroke:#1f9d63,color:#e8fff4
    classDef net fill:#0b2f4d,stroke:#2a7fbf,color:#e8f4ff
    class SA,KV sec
    class PE,DNS,SNET net
