# Version control
.git/
.gitignore

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
env/

# Secrets / config
.env
.env.*

# Data (mounted as volume at runtime — not baked into image)
data/*.xlsx
data/*.xls

# Docs
README.md

# Runtime state — never bake into the image
data/*.db
data/*.db-shm
data/*.db-wal
data/*.log

# Deployment & docs
k8s/
docs/
